NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sift:sift@localhost:5432/sift?schema=public
JWT_SECRET=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
JWT_TTL_SECONDS=2592000

PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace-with-plaid-client-id
PLAID_SECRET=replace-with-plaid-secret
PLAID_CLIENT_NAME=Sift
PLAID_WEBHOOK_URL=http://localhost:3000/v1/webhook/plaid

# Launch-safe default. Set to true only when concierge operations are staffed.
CONCIERGE_ENABLED=false

# Optional internal status-advance token for concierge operations.
ADMIN_TOKEN=replace-only-if-needed
