{
  "name": "sift-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sift backend API for Plaid linking, transaction sync, and concierge cancellation requests.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "pino": "10.1.0",
    "plaid": "42.2.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "tsx": "4.21.0",
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
