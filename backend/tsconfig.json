{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [],
    "typeRoots": ["./src/types"],
    "lib": ["ES2022"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
